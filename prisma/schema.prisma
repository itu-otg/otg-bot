generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model GuildSettings {
  id                      String    @id @default(uuid())
  guildID                 String    @unique
  adminRoleID             String?   @unique
  notificationChannelID   String?   @unique
  prefix                  String?
  lastConfigUpdate        DateTime?
  jamPositionateChannelID String?
  isActive                Boolean   @default(false)
}

model GuildUser {
  id        String @id @default(uuid())
  discordID String
  guildID   String @unique
  xp        Int    @default(0)
}

model Warning {
  id          Int      @id @default(autoincrement())
  userId      String   
  guildId     String   
  moderatorId String   
  reason      String   
  createdAt   DateTime @default(now())
}
model Ban {
  id          Int      @id @default(autoincrement())
  userId      String  
  guildId     String   
  moderatorId String   
  reason      String   
  createdAt   DateTime @default(now())
}

model Kick {
  id          Int      @id @default(autoincrement())
  userId      String   
  guildId     String   
  moderatorId String   
  reason      String   
  createdAt   DateTime @default(now())
}
